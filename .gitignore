# Laravel application ignores
*.log
.DS_Store
.env
.env.backup
.env.production
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
.phpunit.cache
/.fleet
/.idea
/.nova
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/vercel-static
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor

# Keep the checked-in example environment file.
/!.env.example

# Local database and Laravel runtime files
/database/*.sqlite
/database/*.sqlite-*
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/inertia-devtools/
/bootstrap/cache/*.php

# Existing legacy-project ignores (retained during the conversion)
Thumbs.db
ehthumbs.db
Desktop.ini
._*
*.swp
*.swo
*~
.project
.settings/
sessions/
cache/
# Keep the npm lockfile committed for reproducible frontend installs.

# XAMPP/SQL local backups
*.sql.bak
*.sql~
